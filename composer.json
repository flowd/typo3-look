{
	"name": "flowd/typo3-look",
	"description": "\"Look\" what you'll see on your website: content elements in the TYPO3 page module rendered with the real frontend templates, inside an isolated preview frame",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"backend",
		"page module",
		"preview",
		"content blocks"
	],
	"authors": [
		{
			"name": "Sascha Egerer",
			"email": "sascha.egerer@flowd.de",
			"role": "Developer",
			"homepage": "https://flowd.de"
		}
	],
	"homepage": "https://github.com/flowd/typo3-look",
	"support": {
		"issues": "https://github.com/flowd/typo3-look/issues",
		"source": "https://github.com/flowd/typo3-look",
		"docs": "https://docs.typo3.org/p/flowd/typo3-look/main/en-us/"
	},
	"require": {
		"php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
		"psr/http-message": "^1.1 || ^2.0",
		"typo3/cms-backend": "^13.4 || ^14.3",
		"typo3/cms-core": "^13.4 || ^14.3",
		"typo3/cms-fluid": "^13.4 || ^14.3",
		"typo3/cms-frontend": "^13.4 || ^14.3",
		"typo3fluid/fluid": "^4.0 || ^5.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.75",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^11.5 || ^12.0",
		"rector/rector": "^2.1",
		"saschaegerer/phpstan-typo3": "^2.2 || ^3.1",
		"ssch/typo3-rector": "^3.6",
		"typo3/coding-standards": "^0.9",
		"typo3/testing-framework": "^9.6"
	},
	"replace": {
		"typo3-ter/look": "self.version"
	},
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Flowd\\Typo3Look\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Flowd\\Typo3Look\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"lock": false,
		"sort-packages": true,
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"branch-alias": {
			"dev-main": "1.1.x-dev"
		},
		"typo3/cms": {
			"extension-key": "look",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"check": [
			"@check:php:cs-fixer",
			"@check:php:phpstan",
			"@check:php:rector",
			"@check:tests:unit"
		],
		"check:php:cs-fixer": "php-cs-fixer fix --config=Build/php-cs-fixer/config.php --dry-run --diff",
		"check:php:phpstan": "phpstan analyse --configuration=Build/phpstan/phpstan.neon --no-progress",
		"check:php:rector": "rector process --config=Build/rector/config.php --dry-run",
		"check:tests:unit": "phpunit -c Build/phpunit/UnitTests.xml",
		"fix": [
			"@fix:php:rector",
			"@fix:php:cs-fixer"
		],
		"fix:php:cs-fixer": "php-cs-fixer fix --config=Build/php-cs-fixer/config.php",
		"fix:php:rector": "rector process --config=Build/rector/config.php"
	},
	"scripts-descriptions": {
		"check": "Runs all checks: code style, static analysis, Rector, unit tests.",
		"check:php:cs-fixer": "Checks the code style (PHP-CS-Fixer, TYPO3 coding standards).",
		"check:php:phpstan": "Runs the static analysis (PHPStan, level max).",
		"check:php:rector": "Checks whether Rector would change code.",
		"check:tests:unit": "Runs the unit tests.",
		"fix": "Applies Rector and PHP-CS-Fixer."
	}
}
